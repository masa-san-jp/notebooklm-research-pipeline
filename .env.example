# =============================================================================
# notebooklm-research-pipeline — environment variables
# =============================================================================
# Copy this file to `.env` and fill in. NEVER commit `.env`.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Common
# -----------------------------------------------------------------------------
# Brave Search API key
# - Branch A: used as fallback when `nlm source discover` is unavailable
# - Branch B: required for the deep-research loop
# Free tier: 2000 queries/month. Get one at https://api.search.brave.com/
BRAVE_API_KEY=

# -----------------------------------------------------------------------------
# Branch A: Claude Max (Anthropic)
# -----------------------------------------------------------------------------
# Required ONLY when running scripts that call Anthropic SDK directly.
# If you orchestrate from a Claude Code interactive session (Max plan),
# you do not need to set this.
ANTHROPIC_API_KEY=

# Default Claude model (override per-script if needed)
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MODEL_HEAVY=claude-opus-4-7

# -----------------------------------------------------------------------------
# Branch B: LM Studio (or Ollama) + local models
# -----------------------------------------------------------------------------
# OpenAI-compatible local endpoint
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio

# Loaded model identifiers (must match what is loaded in LM Studio)
LM_STUDIO_TEXT_MODEL=gpt-oss-20b
LM_STUDIO_VISION_MODEL=llava-v1.6-mistral-7b

# For Ollama, set:
# LM_STUDIO_URL=http://localhost:11434/v1
# LM_STUDIO_TEXT_MODEL=qwen2.5:32b
# LM_STUDIO_VISION_MODEL=llama3.2-vision:11b

# -----------------------------------------------------------------------------
# Pipeline behavior (optional)
# -----------------------------------------------------------------------------
# Number of sources to ask NotebookLM to discover / pull
SOURCES_MAX=20

# Per-node Brave queries (Branch B)
BRAVE_QUERIES_PER_NODE=3
BRAVE_RESULTS_PER_QUERY=5

# Output directory (relative to repo root)
OUT_DIR=./out
